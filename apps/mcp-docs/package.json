{
  "name": "@repo/mcp-docs",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "//build": "@repo/core/version と @repo/data の dist を読むので、依存を先にビルドする。Cloudflare Pages のビルドコマンドはリポジトリ外の設定なので、パッケージ側で自己完結させる。",
    "build": "pnpm --filter \"@repo/data...\" build && astro build",
    "dev": "astro dev",
    "preview": "astro preview"
  },
  "dependencies": {
    "@repo/core": "workspace:*",
    "@repo/data": "workspace:*",
    "@splidejs/splide": "4.1.4",
    "alpinejs": "3.15.12",
    "astro": "6.4.6"
  },
  "devDependencies": {
    "@astrojs/alpinejs": "0.5.0",
    "sharp": "0.34.5"
  }
}
